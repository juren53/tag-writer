# -*- mode: python ; coding: utf-8 -*-

# Tag Writer - PyInstaller spec file for Windows executable
# Version: 0.3.3
# Updated: 2026-10-25
#
# version_info.txt is generated by generate_version_info.py before each build.
# Run: python generate_version_info.py  (or use build_exe.ps1 / release.bat)

import os

# ThemeManager and Icon_Manager_Module are found at runtime via sys.path
# insertions (src/tag_writer/theme.py, src/main.py) that PyInstaller's static
# analysis never executes, so they must be on pathex or they are silently left
# out of the exe (same failure as ATW v0.7.14a). Fail the build if missing.
_TM_PATH = os.path.expanduser('~/Projects/ThemeManager')
_IMM_PATH = os.path.expanduser('~/Projects/Icon_Manager_Module')
for _dep, _mod in ((_TM_PATH, 'theme_manager'), (_IMM_PATH, 'icon_loader.py')):
    if not os.path.exists(os.path.join(_dep, _mod)):
        raise SystemExit(f'Build dependency missing: {os.path.join(_dep, _mod)}')

a = Analysis(
    ['tag-writer.py'],
    pathex=['src', _TM_PATH, _IMM_PATH],
    binaries=[],
    datas=[
        ('ICON_tw.ico', '.'),  # Include icon file in the bundle
        ('ICON_tw.png', '.'),  # Include PNG fallback
        ('resources/icons', 'resources/icons'),  # IMM icon files
        ('tools/exiftool.exe', 'tools'),  # Bundle ExifTool
        ('Docs', 'Docs'),  # Include documentation
        ('CHANGELOG.md', '.'),  # Include changelog
        ('github_version_checker.py', '.'),  # Version checker module
    ],
    hiddenimports=[
        'tag_writer', 'pyqt_app_info', 'pyqt_app_info.qt',
        'theme_manager', 'icon_loader', 'github_version_checker',
        'exiftool', 'exiftool.exiftool', 'exiftool.constants',
        'exiftool.exceptions', 'exiftool.experimental', 'exiftool.helper',
        'ctypes.wintypes',
    ],
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[],
    noarchive=False,
    optimize=0,
)
pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.datas,
    [],
    name='tag-writer',
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=True,
    upx_exclude=[],
    runtime_tmpdir=None,
    console=False,  # No console window
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
    icon='ICON_tw.ico',  # Use ICO file for Windows taskbar icon
    version='version_info.txt',  # Windows Properties/Details panel metadata
)
